<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Per-monitor DPI awareness, so the window renders natively on every screen instead of being
    bitmap-scaled (which looked soft on the monitor that did not match the system scaling).

    Slint mishandles the resulting rescale - the window ends up the wrong size, see
    slint-ui/slint#11073 (open, upstream) and rust-windowing/winit#3040. The app corrects for that
    itself: it lets the rescale happen so the content is drawn sharply, then forces the window to
    the size Windows says is correct. See pin_dpi_change_size() in main.rs.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
